# Configuración del seminario. Copia este fichero a `.env` solo si necesitas
# cambiar algo: los valores por defecto funcionan sin tocar nada.

# --- Qué modelo usar --------------------------------------------------------
# Si se deja vacío, `comun.elegir_modelo()` prueba en orden:
#   gemma4:31b-cloud -> gpt-oss:20b-cloud -> gemma4:e4b
# Fuerza uno concreto con, por ejemplo:
#   SEMINARIO_MODELO=gemma4:e4b          (local, sin internet, hace tool calling)
SEMINARIO_MODELO=

# --- Dónde está Ollama ------------------------------------------------------
# El daemon local expone la API nativa (/api) y la compatible con OpenAI (/v1).
# Si ya has hecho `ollama signin`, los modelos de nube funcionan por aquí y
# NO necesitas OLLAMA_API_KEY.
OLLAMA_HOST=http://localhost:11434

# --- Solo para acceder a la nube SIN el daemon local ------------------------
# Crea la clave en https://ollama.com/settings/keys y apunta el cliente a
# https://ollama.com/v1. En ese caso el nombre del modelo va SIN el sufijo
# `-cloud` (gemma4:31b, no gemma4:31b-cloud).
OLLAMA_API_KEY=
